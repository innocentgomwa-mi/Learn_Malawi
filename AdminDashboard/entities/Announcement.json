{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "all",
        "students",
        "teachers"
      ],
      "default": "all"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    }
  },
  "required": [
    "title",
    "message"
  ]
}