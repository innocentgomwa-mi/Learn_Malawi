{
  "name": "TeacherPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the post/resource"
    },
    "content": {
      "type": "string",
      "description": "Full content of the post"
    },
    "subject": {
      "type": "string",
      "enum": [
        "Mathematics",
        "English",
        "Science",
        "Social Studies",
        "Chichewa",
        "Biology",
        "Chemistry",
        "Physics",
        "History",
        "Geography",
        "Agriculture",
        "Computer Studies",
        "Religious Education",
        "Other"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "PSLC",
        "JCE",
        "MSCE"
      ]
    },
    "content_type": {
      "type": "string",
      "enum": [
        "study_notes",
        "past_paper",
        "tutorial",
        "quiz",
        "career_resource"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "teacher_name": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "form_standard": {
      "type": "string",
      "description": "e.g. Form 1, Form 2, Standard 5"
    }
  },
  "required": [
    "title",
    "subject",
    "level",
    "content_type"
  ]
}