{
  "name": "DataChangeHistory",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "restore",
        "role_change",
        "suspend",
        "unsuspend"
      ]
    },
    "performed_by_email": {
      "type": "string"
    },
    "performed_by_name": {
      "type": "string"
    },
    "before_data": {
      "type": "string",
      "description": "JSON snapshot before change"
    },
    "after_data": {
      "type": "string",
      "description": "JSON snapshot after change"
    },
    "ip_address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "entity_type",
    "action",
    "performed_by_email"
  ]
}