{
  "name": "ResourceRating",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string"
    },
    "resource_title": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "download_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "resource_id",
    "student_email",
    "rating"
  ]
}