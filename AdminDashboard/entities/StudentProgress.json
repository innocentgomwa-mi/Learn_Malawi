{
  "name": "StudentProgress",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "PSLC",
        "JCE",
        "MSCE"
      ]
    },
    "quizzes_completed": {
      "type": "number",
      "default": 0
    },
    "average_score": {
      "type": "number",
      "default": 0
    },
    "resources_accessed": {
      "type": "number",
      "default": 0
    },
    "last_quiz_score": {
      "type": "number"
    },
    "last_accessed": {
      "type": "string",
      "format": "date"
    },
    "weekly_scores": {
      "type": "array",
      "description": "Array of weekly score objects",
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "student_email",
    "subject"
  ]
}