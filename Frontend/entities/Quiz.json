{
  "name": "Quiz",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Quiz Title"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "level": {
      "type": "string",
      "enum": [
        "PSLC",
        "JCE",
        "MSCE"
      ],
      "title": "Level"
    },
    "grade": {
      "type": "string",
      "title": "Grade/Form"
    },
    "topic": {
      "type": "string",
      "title": "Topic"
    },
    "questions": {
      "type": "array",
      "title": "Questions",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty"
    }
  },
  "required": [
    "title",
    "subject",
    "level"
  ]
}